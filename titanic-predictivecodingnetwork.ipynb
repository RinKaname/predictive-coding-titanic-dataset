    "# ── CELL 2: Load Data (Kaggle paths) ─────────────────────────────────────────\n",
    "df_train = pd.read_csv('titanic_data/train.csv')\n",
    "df_test  = pd.read_csv('titanic_data/test.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {
    "execution": {
